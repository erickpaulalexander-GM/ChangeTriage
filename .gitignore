# Production data and generated artefacts (never commit rows or caches).
# Directory contents are ignored; .gitkeep files preserve the structure.
*.xlsx
workspace/input/*
!workspace/input/.gitkeep
workspace/cache/*
!workspace/cache/.gitkeep
workspace/logs/*
!workspace/logs/.gitkeep
workspace/output/data.json
workspace/output/data/*
workspace/output/triage.html
!workspace/output/data/.gitkeep
# SharePoint publish copies (regenerate via pipeline; never commit rows).
frontend/data/*
!frontend/data/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Local agent tooling (skill registry, scratch).
.atl/
